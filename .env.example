# Replay/mock mode needs no credentials.
TRADECOPILOT_DB_PATH=.tradecopilot/journal.sqlite3
TRADECOPILOT_EXPLANATION_MODE=deterministic

# Optional OpenAI explanations and interactive chat. The server sends sanitized
# deterministic decisions only and attaches no Robinhood or order tools.
# OPENAI_API_KEY=
TRADECOPILOT_CHAT_MODE=deterministic
TRADECOPILOT_OPENAI_MODEL=gpt-5.6
TRADECOPILOT_OPENAI_REASONING_EFFORT=high
# TRADECOPILOT_OPENAI_SAFETY_IDENTIFIER=

# Optional state-transition webhook. HTTPS is required except on localhost.
# TRADECOPILOT_ALERT_WEBHOOK_URL=https://alerts.example/your-private-endpoint

# Shibui supplies a daily public-float snapshot only; it has no intraday data.
TRADECOPILOT_SHIBUI_MCP_URL=https://mcp.shibui.finance/mcp

# Provider credentials are deliberately absent. Store them in the OS keychain:
# uv run tradecopilot auth alpaca
# uv run tradecopilot auth robinhood
# Alpaca live commands select either --alpaca-feed sip or --alpaca-feed iex.

# Sourced news and time-and-sales require a separate file/provider.
# TRADECOPILOT_SUPPLEMENTAL_FEED=/absolute/path/to/supplemental.json

# Do not add OAuth tokens, account numbers, Alpaca keys, or broker credentials here.
